# Copy to .env (git-ignored) and fill in after running build/snowflake_bootstrap.sql:
#   cp .env.example .env && chmod 600 .env
# The scripts read this file from the repo root; variables already set in your shell win.
# No secrets belong here except the optional key passphrase. Never commit .env.

# Account identifier in the org-account form, WITHOUT ".snowflakecomputing.com"
# and without https:// (e.g. MYORG-MYACCOUNT). The last statement of the bootstrap
# SQL prints it as SNOWFLAKE_ACCOUNT.
SNOWFLAKE_ACCOUNT=

# Pipeline service user (TYPE=SERVICE, key-pair only): Python loader, checks, dbt.
SNOWFLAKE_USER=SVC_CRM_PIPELINE

# ABSOLUTE path to the pipeline private key written by `make keys`
# (e.g. /Users/<you>/.snowflake/keys/svc_crm_pipeline.p8). Do not use ~ :
# dbt-snowflake does not expand it.
SNOWFLAKE_PRIVATE_KEY_PATH=

# Optional: only needed if you generated an ENCRYPTED pipeline key
# (make keys ENCRYPT_PIPELINE_KEY=1). Leave empty for an unencrypted key.
# You type this yourself; never paste it into a chat or an assistant. Wrap it in
# SINGLE quotes, e.g. SNOWFLAKE_PRIVATE_KEY_PASSPHRASE='...': unquoted, everything
# after " #" is dropped as a comment. A random passphrase such as the output of
# `openssl rand -base64 24` avoids quoting problems (no spaces, quotes, $ or #).
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

SNOWFLAKE_WAREHOUSE=MARKETING_WH
SNOWFLAKE_DATABASE=MARKETING_CRM

# Roles granted to SVC_CRM_PIPELINE: the loader writes RAW, the transformer reads RAW
# and builds STAGING/MART.
SNOWFLAKE_LOADER_ROLE=CRM_LOADER
SNOWFLAKE_TRANSFORMER_ROLE=CRM_TRANSFORMER

# BI service user for the Google Data Studio connector (reads MART only).
# Used here only by `make sf-check-bi`; its key must stay UNENCRYPTED because the
# connector rejects encrypted private keys.
SNOWFLAKE_BI_USER=SVC_CRM_BI
# ABSOLUTE path, e.g. /Users/<you>/.snowflake/keys/svc_crm_bi.p8
SNOWFLAKE_BI_PRIVATE_KEY_PATH=
SNOWFLAKE_REPORTER_ROLE=CRM_REPORTER
